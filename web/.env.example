# Copy to .env.local for local development — never commit real values

# Base path for GitHub Pages (set to /repo-name/ when hosted at user.github.io/repo-name)
VITE_BASE_PATH=/

# Your Dhurta Host agent endpoint — the Cloudflare Tunnel URL
# Example: https://your-tunnel-name.trycloudflare.com
# Leave empty to let the user enter it on the auth page
VITE_DEFAULT_ENDPOINT=
